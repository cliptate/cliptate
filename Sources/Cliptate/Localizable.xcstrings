    "The source file could not be accessed. It may have been moved or deleted." : {
      "comment" : "History: stale bookmark error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source file could not be accessed. It may have been moved or deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースファイルにアクセスできません。移動または削除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 파일에 접근할 수 없습니다. 이동되었거나 삭제되었을 수 있습니다."
