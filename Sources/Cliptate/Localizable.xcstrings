        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音活动检测模型。Silero 轻量（约 2MB，不支持说话人 ID）；Sortformer 支持说话人分离（约 850MB）。"
          }
        }
      }
    },
