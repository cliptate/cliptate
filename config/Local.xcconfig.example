// Optional public RevenueCat SDK key for your own application.
// Never use RevenueCat secret REST API keys here.
CLIPTATE_REVENUECAT_API_KEY =

// Optional team for Apple Development signing when running directly from Xcode.
// The build script automatically selects a single available development identity.
// CLIPTATE_DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Uncomment for the free direct-distribution channel (also enables Accessibility support).
// CLIPTATE_CHANNEL_CONDITIONS =
// CLIPTATE_ENABLE_APP_SANDBOX = NO
// CLIPTATE_CLI_URL_SCHEME = $(CLIPTATE_DIRECT_CLI_URL_SCHEME)
// CLIPTATE_CLI_URL_SCHEME[config=Debug] = $(CLIPTATE_DIRECT_CLI_URL_SCHEME)

// Public Ed25519 key printed by Sparkle's generate_keys tool (never the private key).
CLIPTATE_SPARKLE_PUBLIC_KEY =
// Set to NO for Mac App Store distribution. APP_STORE still controls accessibility.
// CLIPTATE_UPDATES_ENABLED = NO
