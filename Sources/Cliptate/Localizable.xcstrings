    "This update channel does not have a published update feed yet. Please check the GitHub releases page for available downloads." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此更新渠道尚未发布更新信息。请前往 GitHub 发行页面查看可下载的版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この更新チャンネルには、まだ更新情報が公開されていません。ダウンロード可能なバージョンは GitHub のリリースページでご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 업데이트 채널에는 아직 업데이트 정보가 게시되지 않았습니다. GitHub 릴리스 페이지에서 다운로드 가능한 버전을 확인해 주세요."
          }
        },
