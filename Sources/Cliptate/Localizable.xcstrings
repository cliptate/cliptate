    "Use clipboard text to help AI understand your request.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用剪贴板中的文字，帮助 AI 理解你的请求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードのテキストを使って、AIがリクエストを理解できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드의 텍스트를 사용하여 AI가 요청을 이해하도록 돕습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text aus der Zwischenablage hilft der KI, deine Anfrage zu verstehen."
