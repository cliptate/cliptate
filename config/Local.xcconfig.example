// Optional public RevenueCat SDK key for your own application.
// Never use RevenueCat secret REST API keys here.
CLIPTATE_REVENUECAT_API_KEY =

// Optional team for Apple Development signing when running directly from Xcode.
// The build script automatically selects a single available development identity.
// CLIPTATE_DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Debug defaults to free direct distribution; Release defaults to App Store.
// Uncomment to test App Store behavior when launching Dev directly from Xcode.
// The shell/SwiftPM equivalent is CLIPTATE_APP_STORE=YES.
// CLIPTATE_CHANNEL_CONDITIONS[config=Debug] = APP_STORE
// CLIPTATE_ENABLE_APP_SANDBOX[config=Debug] = YES
// CLIPTATE_CODE_SIGN_ENTITLEMENTS[config=Debug] = $(SRCROOT)/Sources/Cliptate/Cliptate.entitlements
// CLIPTATE_CLI_URL_SCHEME[config=Debug] = cliptate-dev-cli-disabled

// Uncomment for free direct-distribution Release builds in Xcode.
// The shell/SwiftPM equivalent is CLIPTATE_APP_STORE=NO.
// CLIPTATE_CHANNEL_CONDITIONS[config=Release] =
// CLIPTATE_ENABLE_APP_SANDBOX[config=Release] = NO
// CLIPTATE_CODE_SIGN_ENTITLEMENTS[config=Release] = $(SRCROOT)/Sources/Cliptate/Cliptate-Direct.entitlements
// CLIPTATE_CLI_URL_SCHEME[config=Release] = $(CLIPTATE_DIRECT_CLI_URL_SCHEME)

// Public Ed25519 key printed by Sparkle's generate_keys tool (never the private key).
CLIPTATE_SPARKLE_PUBLIC_KEY =
// Set to NO for Mac App Store distribution. APP_STORE still controls accessibility.
// CLIPTATE_UPDATES_ENABLED = NO
