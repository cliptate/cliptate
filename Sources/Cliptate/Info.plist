<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleURLName</key>
                <string>com.cliptate.cli</string>
                <key>CFBundleURLSchemes</key>
                <array><string>$(CLIPTATE_CLI_URL_SCHEME)</string></array>
            </dict>
        </array>
        <key>CliptateRevenueCatAPIKey</key>
        <string>$(CLIPTATE_REVENUECAT_API_KEY)</string>
        <key>CliptateUpdatesEnabled</key>
        <string>$(CLIPTATE_UPDATES_ENABLED)</string>
        <key>SUFeedURL</key>
        <string>$(CLIPTATE_UPDATE_FEED_URL)</string>
        <key>SUPublicEDKey</key>
        <string>$(CLIPTATE_SPARKLE_PUBLIC_KEY)</string>
        <key>SUEnableInstallerLauncherService</key>
        <true />
        <key>SUVerifyUpdateBeforeExtraction</key>
        <true />
        <key>ITSAppUsesNonExemptEncryption</key>
        <false />
        <key>NSMicrophoneUsageDescription</key>
        <string>Cliptate needs access to your microphone to record audio for transcription.</string>
        <key>NSAppleEventsUsageDescription</key>
        <string>Cliptate needs to interact with your browser to detect the current website for
            applying website-specific configurations.</string>
        <key>NSScreenCaptureUsageDescription</key>
        <string>Cliptate needs screen recording access to understand context from your screen
            for improved transcription accuracy.</string>
        <key>CFBundleDocumentTypes</key>
        <array>
            <dict>
                <key>CFBundleVersion</key>
                <string>$(CURRENT_PROJECT_VERSION)</string>
                <key>CFBundleTypeName</key>
                <string>Audio/Video File</string>
                <key>CFBundleTypeRole</key>
                <string>Viewer</string>
                <key>LSHandlerRank</key>
                <string>Alternate</string>
                <key>LSItemContentTypes</key>
                <array>
                    <string>public.audio</string>
                    <string>public.movie</string>
                </array>
                <key>CFBundleTypeExtensions</key>
                <array>
                    <string>wav</string>
                    <string>mp3</string>
                    <string>m4a</string>
                    <string>aiff</string>
                    <string>mp4</string>
                    <string>mov</string>
                    <string>aac</string>
                    <string>flac</string>
                    <string>caf</string>
                </array>
            </dict>
        </array>
    </dict>
</plist>
